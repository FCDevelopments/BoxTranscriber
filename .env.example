# ── AssemblyAI ────────────────────────────────────────────────────────────────
# Get your free API key at https://www.assemblyai.com
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ── Box ───────────────────────────────────────────────────────────────────────
# The ID of the Box folder that contains the videos to transcribe.
# Open the folder in Box and copy the number from the URL:
#   https://app.box.com/folder/123456789012  ->  123456789012
BOX_FOLDER_ID=your_box_folder_id_here

# ── ffmpeg (optional) ─────────────────────────────────────────────────────────
# Only needed for video files larger than 2 GB.
# If ffmpeg is in your system PATH, leave this blank.
# Otherwise set the full path to ffmpeg.exe:
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
